{
  "description": "Windowsデスクトップの実画面テスト前にCLI検証を確認する",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) 'dev/scripts/confirm-cli-before-computer-use.ps1')\"",
            "timeout": 10,
            "statusMessage": "CLI検証hookの呼び出しを診断中"
          }
        ]
      }
    ]
  }
}
