<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.13</Version>
    <ApplicationIcon>assets/KotorinToys.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App.WindowsForms" RuntimeFrameworkVersion="10.0.13" Condition="'$(SelfContained)' == 'true'" />
    <EmbeddedResource Include="assets/KotorinToys.ico" LogicalName="KotorinToys.AppIcon.ico" />
    <None Include="../../catalog/tools.json" Link="catalog/tools.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../config/tools.json" Link="config/tools.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../../contracts/ManagementEndpoint.cs" Link="Integration/ManagementEndpoint.cs" />
    <InternalsVisibleTo Include="KotorinToys.Tests" />
  </ItemGroup>
</Project>
